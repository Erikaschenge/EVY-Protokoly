rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    match /templates/{id} { allow read, write: if signedIn(); }
    match /trainsets/{id} { allow read, write: if signedIn(); }
    match /protocolPackages/{id} { allow read, write: if signedIn(); }
    match /findings/{id} { allow read, write: if signedIn(); }
    match /{document=**} { allow read, write: if false; }
  }
}
