rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    match /templates/{documentId}/{fileName} { allow read, write: if signedIn() && request.resource.size < 10 * 1024 * 1024; }
    match /trainsets/{documentId}/{fileName} { allow read, write: if signedIn() && request.resource.size < 10 * 1024 * 1024; }
    match /findings/{documentId}/{fileName} { allow read, write: if signedIn() && request.resource.size < 10 * 1024 * 1024; }
    match /protocolPackages/{documentId}/{fileName} { allow read, write: if signedIn() && request.resource.size < 10 * 1024 * 1024; }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
