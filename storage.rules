rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function validImageUpload() {
      return request.resource != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /templates/{documentId}/{fileName} {
      allow read: if signedIn();
      allow create, update: if signedIn() && validImageUpload();
      allow delete: if signedIn();
    }

    match /trainsets/{documentId}/{fileName} {
      allow read: if signedIn();
      allow create, update: if signedIn() && validImageUpload();
      allow delete: if signedIn();
    }

    match /findings/{documentId}/{fileName} {
      allow read: if signedIn();
      allow create, update: if signedIn() && validImageUpload();
      allow delete: if signedIn();
    }

    match /protocolPackages/{documentId}/{fileName} {
      allow read: if signedIn();
      allow create, update: if signedIn() && validImageUpload();
      allow delete: if signedIn();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
